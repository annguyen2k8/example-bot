# ==========================================
# ExampleBot Environment Configuration (.env)
# ==========================================

# Discord Bot Credentials (Required)
DISCORD_TOKEN=your_discord_bot_token_here

# Command Prefix & Description (Optional)
COMMAND_PREFIX=!,?
BOT_DESCRIPTION=I'm a example bot!
EMBED_COLOR=0x5865F2

# MongoDB Database Configuration (Optional)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=example_bot
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_POOL_SIZE=20
MONGODB_TIMEOUT_MS=5000

# Logging & Operational Configuration (Optional)
LOG_LEVEL=INFO
LOGS_DIR=logs
SYNC_COMMANDS_ON_STARTUP=false
